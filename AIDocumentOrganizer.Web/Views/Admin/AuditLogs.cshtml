@model List<AIDocumentOrganizer.Web.Models.Entities.AuditLog>
@{
    ViewData["Title"] = "Audit Logs";
    ViewData["PageTitle"] = "Audit Logs";
}

<partial name="_AdminNav" />

<div class="doc-card p-0 overflow-hidden">
    <div class="p-3 d-flex justify-content-between align-items-center" style="border-bottom:1px solid var(--border);">
        <h5 class="mb-0 fw-600" style="font-size:15px;">
            <i class="bi bi-list-check me-2 text-primary"></i>Audit Trail (Page @ViewBag.Page of @ViewBag.TotalPages)
        </h5>
        <a asp-action="ExportAuditLogs" class="btn btn-outline-secondary btn-sm" title="Export Audit Logs CSV">
            <i class="bi bi-download me-1"></i> Export CSV
        </a>
    </div>
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Timestamp</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Target Entity</th>
                    <th>IP Address</th>
                    <th>Operation Details</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">No audit logs recorded yet.</td>
                    </tr>
                }
                @foreach (var log in Model)
                {
                    <tr>
                        <td style="font-size:12px; color:var(--text-muted); white-space:nowrap;">@log.Timestamp.ToString("dd MMM yyyy HH:mm:ss")</td>
                        <td style="font-size:13px; color:var(--text-secondary);">@(log.User?.Email ?? log.UserId ?? "System")</td>
                        <td><span class="badge-status badge-valid" style="font-size:11px;">@log.Action</span></td>
                        <td style="font-size:12px; color:var(--text-muted);">@log.EntityName</td>
                        <td style="font-size:12px; color:var(--text-muted);">@(log.IpAddress ?? "—")</td>
                        <td style="font-size:12px; color:var(--text-secondary); max-width:320px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="@log.Details">@log.Details</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if ((int)ViewBag.TotalPages > 1)
{
    <nav class="mt-4 d-flex justify-content-center">
        <ul class="pagination">
            @for (var p = 1; p <= (int)ViewBag.TotalPages; p++)
            {
                <li class="page-item @(p == (int)ViewBag.Page ? "active" : "")">
                    <a class="page-link" asp-action="AuditLogs" asp-route-page="@p">@p</a>
                </li>
            }
        </ul>
    </nav>
}
