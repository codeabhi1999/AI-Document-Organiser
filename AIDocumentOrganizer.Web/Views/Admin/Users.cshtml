@model List<AIDocumentOrganizer.Web.ViewModels.AdminUserItem>
@{
    ViewData["Title"] = "User Management";
    ViewData["PageTitle"] = "User Management";
}

<div class="doc-card p-0 overflow-hidden">
    <div class="p-3" style="border-bottom:1px solid var(--border);">
        <h5 class="mb-0 fw-600" style="font-size:15px;"><i class="bi bi-people me-2"></i>All Users (@Model.Count)</h5>
    </div>
    <table class="admin-table">
        <thead>
            <tr>
                <th>User</th>
                <th>Docs</th>
                <th>Roles</th>
                <th>Status</th>
                <th>Joined</th>
                <th>Last Login</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <div style="width:32px; height:32px; border-radius:50%; background:linear-gradient(135deg, var(--primary), var(--accent)); display:flex; align-items:center; justify-content:center; font-size:13px; color:#fff; font-weight:700; flex-shrink:0;">
                                @u.FullName.Substring(0,1).ToUpper()
                            </div>
                            <div>
                                <div style="font-size:14px; font-weight:500; color:var(--text-primary);">@u.FullName</div>
                                <div style="font-size:12px; color:var(--text-muted);">@u.Email</div>
                            </div>
                        </div>
                    </td>
                    <td style="color:var(--text-secondary);">@u.DocumentCount</td>
                    <td>
                        @foreach (var r in u.Roles)
                        {
                            <span class="badge-status @(r == "Admin" ? "badge-expired" : "badge-valid")" style="font-size:11px; margin-right:3px;">@r</span>
                        }
                    </td>
                    <td>
                        <span class="badge-status @(u.IsActive ? "badge-valid" : "badge-expired")" style="font-size:11px;">@(u.IsActive ? "Active" : "Inactive")</span>
                    </td>
                    <td style="font-size:13px; color:var(--text-secondary);">@u.CreatedAt.ToString("dd MMM yyyy")</td>
                    <td style="font-size:13px; color:var(--text-secondary);">@(u.LastLoginAt.HasValue ? u.LastLoginAt.Value.ToString("dd MMM HH:mm") : "Never")</td>
                    <td>
                        <form asp-action="ToggleUserActive" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@u.Id" />
                            <button type="submit" class="btn btn-outline-secondary btn-sm" style="font-size:12px; padding:3px 10px;">
                                @(u.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
