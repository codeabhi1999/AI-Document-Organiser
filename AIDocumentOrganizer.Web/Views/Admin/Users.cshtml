@model AIDocumentOrganizer.Web.ViewModels.AdminUsersViewModel
@{
    ViewData["Title"] = "User Management";
    ViewData["PageTitle"] = "User Management";
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<partial name="_AdminNav" />

<!-- User Overview Metrics -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="admin-metric-card">
            <div class="metric-header">
                <span class="metric-label">Total Users</span>
                <i class="bi bi-people text-primary fs-5"></i>
            </div>
            <div class="metric-value">@Model.TotalUsers</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="admin-metric-card">
            <div class="metric-header">
                <span class="metric-label">Active Users</span>
                <i class="bi bi-check-circle text-success fs-5"></i>
            </div>
            <div class="metric-value">@Model.ActiveUsers</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="admin-metric-card">
            <div class="metric-header">
                <span class="metric-label">Inactive Users</span>
                <i class="bi bi-x-circle text-danger fs-5"></i>
            </div>
            <div class="metric-value">@Model.InactiveUsers</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="admin-metric-card">
            <div class="metric-header">
                <span class="metric-label">Administrators</span>
                <i class="bi bi-shield-check text-warning fs-5"></i>
            </div>
            <div class="metric-value">@Model.AdminCount</div>
        </div>
    </div>
</div>

<!-- Search and Filter Bar -->
<div class="admin-filter-bar">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@Model.Search" class="form-control border-start-0 ps-0" placeholder="Search by name or email..." />
            </div>
        </div>
        <div class="col-md-3">
            <select name="roleFilter" class="form-select">
                <option value="">All Roles</option>
                <option value="Admin" selected="@(Model.RoleFilter == "Admin")">Administrators</option>
                <option value="User" selected="@(Model.RoleFilter == "User")">Regular Users</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="statusFilter" class="form-select">
                <option value="">All Statuses</option>
                <option value="active" selected="@(Model.StatusFilter == "active")">Active Only</option>
                <option value="inactive" selected="@(Model.StatusFilter == "inactive")">Inactive Only</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary btn-sm flex-fill"><i class="bi bi-funnel me-1"></i> Filter</button>
            <a asp-action="Users" class="btn btn-outline-secondary btn-sm" title="Clear Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
            <a asp-action="ExportUsers" class="btn btn-outline-secondary btn-sm" title="Export CSV"><i class="bi bi-download"></i></a>
        </div>
    </form>
</div>

<!-- Users Table -->
<div class="doc-card p-0 overflow-hidden">
    <div class="p-3 d-flex justify-content-between align-items-center" style="border-bottom:1px solid var(--border);">
        <h5 class="mb-0 fw-600" style="font-size:15px;">
            <i class="bi bi-people me-2 text-primary"></i>Users (@Model.Users.Count)
        </h5>
    </div>
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Docs</th>
                    <th>Roles</th>
                    <th>Status</th>
                    <th>Joined</th>
                    <th>Last Login</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Users.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="bi bi-person-x fs-3 d-block mb-2"></i>
                            No users matched your search criteria.
                        </td>
                    </tr>
                }
                @foreach (var u in Model.Users)
                {
                    var isSelf = u.Id == currentUserId;
                    var isAdmin = u.Roles.Contains("Admin");
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div style="width:34px; height:34px; border-radius:50%; background:linear-gradient(135deg, var(--primary), var(--accent)); display:flex; align-items:center; justify-content:center; font-size:13px; color:#fff; font-weight:700; flex-shrink:0;">
                                    @(string.IsNullOrEmpty(u.FullName) ? "U" : u.FullName.Substring(0, 1).ToUpper())
                                </div>
                                <div>
                                    <div style="font-size:14px; font-weight:500; color:var(--text-primary);">
                                        @u.FullName
                                        @if (isSelf)
                                        {
                                            <span class="badge bg-secondary ms-1" style="font-size:10px;">You</span>
                                        }
                                    </div>
                                    <div style="font-size:12px; color:var(--text-muted);">@u.Email</div>
                                </div>
                            </div>
                        </td>
                        <td style="color:var(--text-secondary);"><span class="badge bg-dark border">@u.DocumentCount</span></td>
                        <td>
                            @foreach (var r in u.Roles)
                            {
                                <span class="badge-status @(r == "Admin" ? "badge-expiring" : "badge-valid")" style="font-size:11px; margin-right:3px;">
                                    @(r == "Admin" ? "🛡️ Admin" : r)
                                </span>
                            }
                        </td>
                        <td>
                            <span class="badge-status @(u.IsActive ? "badge-valid" : "badge-expired")" style="font-size:11px;">
                                @(u.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td style="font-size:13px; color:var(--text-secondary);">@u.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td style="font-size:13px; color:var(--text-secondary);">@(u.LastLoginAt.HasValue ? u.LastLoginAt.Value.ToString("dd MMM HH:mm") : "Never")</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <!-- Toggle Active -->
                                @if (!isSelf)
                                {
                                    <form asp-action="ToggleUserActive" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@u.Id" />
                                        <button type="submit" class="btn btn-outline-secondary btn-sm" style="font-size:12px; padding:3px 8px;" title="@(u.IsActive ? "Deactivate account" : "Activate account")">
                                            <i class="bi @(u.IsActive ? "bi-person-slash text-warning" : "bi-person-check text-success")"></i>
                                        </button>
                                    </form>

                                    <!-- Toggle Role -->
                                    <form asp-action="ToggleUserRole" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@u.Id" />
                                        <button type="submit" class="btn btn-outline-secondary btn-sm" style="font-size:12px; padding:3px 8px;" title="@(isAdmin ? "Demote from Admin" : "Promote to Admin")">
                                            <i class="bi @(isAdmin ? "bi-shield-slash text-danger" : "bi-shield-plus text-primary")"></i>
                                        </button>
                                    </form>
                                }

                                <!-- Reset Password Modal Button -->
                                <button type="button" class="btn btn-outline-secondary btn-sm" style="font-size:12px; padding:3px 8px;" data-bs-toggle="modal" data-bs-target="#resetModal-@u.Id" title="Reset Password">
                                    <i class="bi bi-key text-info"></i>
                                </button>
                            </div>

                            <!-- Modal for Reset Password -->
                            <div class="modal fade text-start" id="resetModal-@u.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content" style="background:var(--bg-card-solid); border:1px solid var(--border); color:#fff;">
                                        <div class="modal-header border-bottom border-secondary">
                                            <h6 class="modal-title"><i class="bi bi-key me-2 text-warning"></i>Reset Password for @u.FullName</h6>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <form asp-action="ResetUserPassword" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.Id" />
                                            <div class="modal-body">
                                                <p class="text-secondary small mb-3">Set a new secure password for <strong>@u.Email</strong>. Password must be at least 8 characters with digits, uppercase, and special characters.</p>
                                                <div class="mb-3">
                                                    <label class="form-label small fw-bold">New Password</label>
                                                    <input type="password" name="newPassword" class="form-control" required minlength="8" placeholder="Enter new strong password" />
                                                </div>
                                            </div>
                                            <div class="modal-footer border-top border-secondary">
                                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-warning btn-sm"><i class="bi bi-check-lg me-1"></i>Reset Password</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
