@model List<AIDocumentOrganizer.Web.Models.Entities.AIProcessingLog>
@{
    ViewData["Title"] = "AI Processing Logs";
    ViewData["PageTitle"] = "AI Processing Logs";
}

<partial name="_AdminNav" />

<div class="doc-card p-0 overflow-hidden">
    <div class="p-3 d-flex justify-content-between align-items-center" style="border-bottom:1px solid var(--border);">
        <h5 class="mb-0 fw-600" style="font-size:15px;">
            <i class="bi bi-cpu me-2 text-primary"></i>AI Processing Activity (Page @ViewBag.Page of @ViewBag.TotalPages)
        </h5>
        <a asp-action="SystemHealth" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-heart-pulse me-1"></i> AI Diagnostics
        </a>
    </div>
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Processed At</th>
                    <th>Document</th>
                    <th>Model</th>
                    <th>Prompt Tokens</th>
                    <th>Response Tokens</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Error Detail</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">No AI processing logs available.</td>
                    </tr>
                }
                @foreach (var log in Model)
                {
                    <tr>
                        <td style="font-size:12px; color:var(--text-muted); white-space:nowrap;">@log.ProcessedAt.ToString("dd MMM yyyy HH:mm:ss")</td>
                        <td style="font-size:13px; color:var(--text-primary); font-weight:500;">@(log.Document?.Title ?? "Deleted Document")</td>
                        <td style="font-size:12px; color:var(--text-muted);"><code>@log.ModelName</code></td>
                        <td style="font-size:13px; color:var(--text-secondary);">@log.PromptTokens</td>
                        <td style="font-size:13px; color:var(--text-secondary);">@log.ResponseTokens</td>
                        <td style="font-size:13px; font-weight:600; color:var(--text-secondary);">@(log.PromptTokens + log.ResponseTokens)</td>
                        <td>
                            <span class="badge-status @(log.Success ? "badge-valid" : "badge-failed")" style="font-size:11px;">
                                @(log.Success ? "Success" : "Failed")
                            </span>
                        </td>
                        <td style="font-size:12px; color:var(--danger); max-width:260px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="@log.ErrorMessage">
                            @(string.IsNullOrEmpty(log.ErrorMessage) ? "—" : log.ErrorMessage)
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if ((int)ViewBag.TotalPages > 1)
{
    <nav class="mt-4 d-flex justify-content-center">
        <ul class="pagination">
            @for (var p = 1; p <= (int)ViewBag.TotalPages; p++)
            {
                <li class="page-item @(p == (int)ViewBag.Page ? "active" : "")">
                    <a class="page-link" asp-action="AiLogs" asp-route-page="@p">@p</a>
                </li>
            }
        </ul>
    </nav>
}
