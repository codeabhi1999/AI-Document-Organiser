@model List<AIDocumentOrganizer.Web.Models.Entities.AIProcessingLog>
@{
    ViewData["Title"] = "AI Processing Logs";
    ViewData["PageTitle"] = "AI Processing Logs";
}
<div class="doc-card p-0 overflow-hidden">
    <div class="p-3" style="border-bottom:1px solid var(--border);">
        <h5 class="mb-0 fw-600" style="font-size:15px;"><i class="bi bi-robot me-2" style="color:var(--accent);"></i>AI Processing Logs (Page @ViewBag.Page of @ViewBag.TotalPages)</h5>
    </div>
    <table class="admin-table">
        <thead><tr><th>Time</th><th>Document</th><th>Model</th><th>Prompt Tokens</th><th>Response Tokens</th><th>Status</th><th>Error</th></tr></thead>
        <tbody>
            @foreach (var log in Model)
            {
                <tr>
                    <td style="font-size:12px; color:var(--text-muted); white-space:nowrap;">@log.ProcessedAt.ToString("dd MMM HH:mm")</td>
                    <td style="font-size:13px; color:var(--text-secondary);">@(log.Document?.Title ?? "Deleted")</td>
                    <td style="font-size:12px; color:var(--text-muted);">@log.ModelName</td>
                    <td style="font-size:13px; color:var(--text-secondary);">@log.PromptTokens</td>
                    <td style="font-size:13px; color:var(--text-secondary);">@log.ResponseTokens</td>
                    <td><span class="badge-status @(log.Success ? "badge-valid" : "badge-failed")" style="font-size:11px;">@(log.Success ? "Success" : "Failed")</span></td>
                    <td style="font-size:12px; color:var(--danger); max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="@log.ErrorMessage">@log.ErrorMessage</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<nav class="mt-3 d-flex justify-content-center">
    <ul class="pagination">
        @for (var p = 1; p <= (int)ViewBag.TotalPages; p++)
        {
            <li class="page-item @(p == (int)ViewBag.Page ? "active" : "")">
                <a class="page-link" asp-action="AiLogs" asp-route-page="@p">@p</a>
            </li>
        }
    </ul>
</nav>
