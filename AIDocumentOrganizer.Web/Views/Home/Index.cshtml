@{
    ViewData["Title"] = "DocVault — Next-Gen AI Document Organizer";
    ViewData["Description"] = "Store, analyze, and manage your personal documents with AI-powered extraction, OCR, and smart expiry notifications.";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="landing-hero-container">
    <!-- Ambient light orbs -->
    <div class="ambient-glow ambient-glow-1"></div>
    <div class="ambient-glow ambient-glow-2"></div>
    <div class="ambient-glow ambient-glow-3"></div>

    <div class="container position-relative py-5">
        <div class="row align-items-center g-5 min-vh-75">
            <!-- Left Column: Copy & CTAs -->
            <div class="col-lg-6 z-2">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 mb-4 pill-badge-glow">
                    <span class="pulse-dot"></span>
                    <span class="badge-text"><i class="bi bi-stars text-warning me-1"></i> Powered by Google Gemini 1.5 Flash & OCR</span>
                </div>

                <h1 class="hero-headline mb-4">
                    Your Documents.<br>
                    <span class="gradient-text-hero">Intelligently Vaulted</span><br>
                    Never Expired.
                </h1>

                <p class="hero-subtitle mb-4">
                    The ultra-secure, AI-native organizer for your Aadhaar, PAN, Passport, Policies & Bills. 
                    Extracts metadata in milliseconds, tracks validity, and alerts you before deadlines strike.
                </p>

                <!-- Quick Action CTAs -->
                <div class="d-flex flex-wrap align-items-center gap-3 mb-5">
                    <a asp-controller="Account" asp-action="Register" class="btn btn-hero-primary shadow-glow-lg">
                        <i class="bi bi-rocket-takeoff-fill me-2"></i>Create Free Vault
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-hero-secondary">
                        <i class="bi bi-play-circle-fill me-2 text-primary"></i>Live Demo Sign In
                    </a>
                </div>

                <!-- Trust Metrics -->
                <div class="row g-3 pt-4 border-top border-secondary-subtle">
                    <div class="col-4">
                        <div class="stat-mini-value">99.8%</div>
                        <div class="stat-mini-label">AI Accuracy</div>
                    </div>
                    <div class="col-4">
                        <div class="stat-mini-value">&lt; 0.8s</div>
                        <div class="stat-mini-label">OCR Parsing</div>
                    </div>
                    <div class="col-4">
                        <div class="stat-mini-value">AES-256</div>
                        <div class="stat-mini-label">Vault Security</div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Interactive 3D Mock Preview Window -->
            <div class="col-lg-6 z-2">
                <div class="hero-preview-window">
                    <div class="preview-window-bar">
                        <div class="traffic-lights">
                            <span class="light red"></span>
                            <span class="light yellow"></span>
                            <span class="light green"></span>
                        </div>
                        <div class="preview-address-bar">
                            <i class="bi bi-lock-fill text-success me-1"></i> docvault.local / secure-ai-analysis
                        </div>
                        <div class="preview-status-tag">
                            <span class="badge bg-success-subtle text-success border border-success-subtle">LIVE DEMO</span>
                        </div>
                    </div>

                    <!-- Inner Simulated Document Card -->
                    <div class="preview-window-body">
                        <!-- Hologram Scanner Bar -->
                        <div class="scanner-line"></div>

                        <!-- Card Header -->
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="doc-avatar-icon">
                                    <i class="bi bi-person-vcard-fill text-primary"></i>
                                </div>
                                <div>
                                    <div class="preview-doc-title">Passport_International_Republic.pdf</div>
                                    <div class="preview-doc-sub"><i class="bi bi-shield-check text-success me-1"></i>Verified Identity &middot; 4.2 MB</div>
                                </div>
                            </div>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill">
                                <i class="bi bi-stars me-1"></i>AI Classified
                            </span>
                        </div>

                        <!-- Extracted Metadata Grid -->
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <div class="meta-preview-box">
                                    <span class="meta-key">Document Number</span>
                                    <span class="meta-val text-mono">Z8492041 <i class="bi bi-patch-check-fill text-info ms-1"></i></span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="meta-preview-box">
                                    <span class="meta-key">Issuing Authority</span>
                                    <span class="meta-val">Govt. Passport Office</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="meta-preview-box">
                                    <span class="meta-key">Issue Date</span>
                                    <span class="meta-val">14 Jun 2020</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="meta-preview-box highlight-warning">
                                    <span class="meta-key">Expiry Date</span>
                                    <span class="meta-val text-warning"><i class="bi bi-clock-history me-1"></i>13 Jun 2030</span>
                                </div>
                            </div>
                        </div>

                        <!-- Floating Smart Tags -->
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <span class="preview-chip"><i class="bi bi-tag-fill me-1 text-info"></i>Passport</span>
                            <span class="preview-chip"><i class="bi bi-airplane-engines me-1 text-primary"></i>Travel</span>
                            <span class="preview-chip"><i class="bi bi-fingerprint me-1 text-success"></i>High Priority</span>
                            <span class="preview-chip highlight"><i class="bi bi-bell-fill me-1 text-warning"></i>Reminder Set (30d)</span>
                        </div>

                        <!-- AI Summary Box -->
                        <div class="ai-summary-pill">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <i class="bi bi-lightning-charge-fill text-warning"></i>
                                <span class="ai-summary-title">Gemini 1.5 Synthesis</span>
                                <span class="badge bg-dark border border-secondary text-secondary ms-auto" style="font-size: 10px;">Confidence: 99.4%</span>
                            </div>
                            <p class="ai-summary-text mb-0">
                                Valid 10-year official passport for international travel. Next renewal window scheduled in 2030. No biometric discrepancies detected.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Features Showcase Grid -->
    <section class="landing-features-section py-5">
        <div class="container">
            <div class="text-center max-w-700 mx-auto mb-5">
                <span class="badge badge-accent mb-2">ENGINEERED FOR EXCELLENCE</span>
                <h2 class="section-title">Everything You Need for Total Document Peace of Mind</h2>
                <p class="section-subtitle">
                    Designed to combine enterprise bank-grade security with fluid artificial intelligence.
                </p>
            </div>

            <div class="row g-4">
                <div class="col-md-4">
                    <div class="modern-feature-card">
                        <div class="card-glow-top"></div>
                        <div class="feature-icon-wrapper" style="--accent-glow: #6366f1;">
                            <i class="bi bi-file-earmark-medical-fill"></i>
                        </div>
                        <h4 class="feature-card-title">Intelligent Dual OCR</h4>
                        <p class="feature-card-text">
                            Direct vector text streaming via PdfPig for high-fidelity digital PDFs, combined with adaptive Tesseract neural OCR for scanned phone photos and camera captures.
                        </p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="modern-feature-card">
                        <div class="card-glow-top" style="background: linear-gradient(90deg, #ec4899, #8b5cf6);"></div>
                        <div class="feature-icon-wrapper" style="--accent-glow: #ec4899;">
                            <i class="bi bi-stars"></i>
                        </div>
                        <h4 class="feature-card-title">Gemini 1.5 Flash Analysis</h4>
                        <p class="feature-card-text">
                            Automatically identifies document class, extracts entity numbers, issues dates, and tags with deep cognitive comprehension, backed by zero-latency regex fallbacks.
                        </p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="modern-feature-card">
                        <div class="card-glow-top" style="background: linear-gradient(90deg, #10b981, #06b6d4);"></div>
                        <div class="feature-icon-wrapper" style="--accent-glow: #10b981;">
                            <i class="bi bi-alarm-fill"></i>
                        </div>
                        <h4 class="feature-card-title">Proactive Expiry Engine</h4>
                        <p class="feature-card-text">
                            Background services run daily scans at 30, 15, 7, and 1-day windows, dispatching rich HTML email notifications and in-app alerts before critical licenses expire.
                        </p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="modern-feature-card">
                        <div class="card-glow-top" style="background: linear-gradient(90deg, #06b6d4, #3b82f6);"></div>
                        <div class="feature-icon-wrapper" style="--accent-glow: #06b6d4;">
                            <i class="bi bi-chat-left-dots-fill"></i>
                        </div>
                        <h4 class="feature-card-title">Interactive RAG AI Assistant</h4>
                        <p class="feature-card-text">
                            Ask questions like "When is my car insurance due?" or "What is my passport number?". Your assistant queries your encrypted vault text in natural conversational speech.
                        </p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="modern-feature-card">
                        <div class="card-glow-top" style="background: linear-gradient(90deg, #f59e0b, #ef4444);"></div>
                        <div class="feature-icon-wrapper" style="--accent-glow: #f59e0b;">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>
                        <h4 class="feature-card-title">Zero-Trust Isolation</h4>
                        <p class="feature-card-text">
                            Files reside in secluded non-public directories mapped to cryptographically isolated user tenants. Full immutable audit trail logs every access, download, and modification.
                        </p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="modern-feature-card">
                        <div class="card-glow-top" style="background: linear-gradient(90deg, #a855f7, #6366f1);"></div>
                        <div class="feature-icon-wrapper" style="--accent-glow: #a855f7;">
                            <i class="bi bi-layers-fill"></i>
                        </div>
                        <h4 class="feature-card-title">Version History & Re-upload</h4>
                        <p class="feature-card-text">
                            Renewing a license or updated policy? Simply upload a new version. The system preserves chronological history, previous OCR transcripts, and timestamps intact.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Supported Documents Marquee Banner -->
    <section class="py-5 border-top border-bottom border-secondary-subtle bg-dark-gradient">
        <div class="container text-center">
            <h5 class="text-uppercase text-secondary small fw-bold tracking-widest mb-4">
                Engineered to Recognize All Personal, Government & Financial Records
            </h5>
            <div class="d-flex flex-wrap justify-content-center gap-3">
                @{
                    var docs = new[]
                    {
                        new { Name = "Aadhaar Card", Icon = "bi-person-badge", Color = "#6366f1" },
                        new { Name = "PAN Card", Icon = "bi-credit-card-2-front", Color = "#ec4899" },
                        new { Name = "Passport", Icon = "bi-airplane", Color = "#06b6d4" },
                        new { Name = "Driving License", Icon = "bi-car-front", Color = "#10b981" },
                        new { Name = "Vehicle Insurance", Icon = "bi-shield-shaded", Color = "#f59e0b" },
                        new { Name = "Health Policy", Icon = "bi-heart-pulse", Color = "#ef4444" },
                        new { Name = "Life Insurance", Icon = "bi-umbrella", Color = "#8b5cf6" },
                        new { Name = "Rental Agreement", Icon = "bi-house-check", Color = "#14b8a6" },
                        new { Name = "Bank Statements", Icon = "bi-bank", Color = "#3b82f6" },
                        new { Name = "Utility Bills", Icon = "bi-receipt-cutoff", Color = "#eab308" },
                        new { Name = "Degree Certificates", Icon = "bi-mortarboard", Color = "#d946ef" }
                    };
                }
                @foreach (var d in docs)
                {
                    <div class="document-badge-pill">
                        <i class="@d.Icon" style="color: @d.Color;"></i>
                        <span>@d.Name</span>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- Call to Action Footer Section -->
    <section class="py-5 text-center position-relative">
        <div class="container py-4">
            <div class="cta-banner-glass p-5 rounded-4 max-w-900 mx-auto">
                <div class="badge badge-accent mb-3">GET STARTED IN UNDER 60 SECONDS</div>
                <h2 class="display-6 fw-bold text-white mb-3">Ready to Never Lose a Document Again?</h2>
                <p class="text-secondary mb-4 fs-6 max-w-600 mx-auto">
                    Experience peace of mind with intelligent document classification and autonomous expiry tracking today.
                </p>
                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <a asp-controller="Account" asp-action="Register" class="btn btn-hero-primary px-4 py-2">
                        <i class="bi bi-person-plus-fill me-2"></i>Create Free Account
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light px-4 py-2">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Sign In with Demo User
                    </a>
                </div>
            </div>
        </div>
    </section>
</div>
