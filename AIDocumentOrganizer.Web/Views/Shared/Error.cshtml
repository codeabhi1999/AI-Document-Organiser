@{
    ViewData["Title"] = "Error";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-page">
    <div class="auth-card text-center">
        <div class="auth-logo" style="background:linear-gradient(135deg,#e63946,#7209b7);"><i class="bi bi-exclamation-triangle-fill"></i></div>
        <h1 class="auth-title">Something Went Wrong</h1>
        <p class="auth-sub">An unexpected error occurred. Please try again or contact support.</p>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary w-100 py-2 mt-3"><i class="bi bi-house me-2"></i>Go Home</a>
    </div>
</div>
