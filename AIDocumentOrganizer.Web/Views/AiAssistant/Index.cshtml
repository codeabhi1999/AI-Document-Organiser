@model AIDocumentOrganizer.Web.ViewModels.AiAssistantViewModel
@{
    ViewData["Title"] = "AI Vault Assistant — DocVault";
    ViewData["PageTitle"] = "AI Vault Intelligence";
}
@Html.AntiForgeryToken()

<div class="ai-assistant-container">
    <!-- Header Banner -->
    <div class="ai-assistant-hero mb-3">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="ai-avatar-badge">
                    <i class="bi bi-robot"></i>
                    <span class="ai-status-indicator"></span>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h4 class="text-white fw-bold mb-0">Document Intelligence Copilot</h4>
                        <span class="badge badge-ai-pulse">GEMINI 1.5 FLASH</span>
                    </div>
                    <p class="text-secondary small mb-0">
                        Context-aware RAG querying over all your securely indexed vault documents.
                    </p>
                </div>
            </div>
            <div class="ai-meta-pills d-flex gap-2">
                <span class="ai-pill"><i class="bi bi-lock-fill text-success me-1"></i>Zero Data Sharing</span>
                <span class="ai-pill"><i class="bi bi-cpu-fill text-info me-1"></i>Indexed Text</span>
            </div>
        </div>
    </div>

    <!-- Suggested Query Chips -->
    <div class="suggestion-chips-wrapper mb-3" id="suggestions">
        <span class="suggestion-label"><i class="bi bi-lightbulb-fill text-warning me-1"></i>Try asking:</span>
        @{
            var suggestions = new[]
            {
                "Which documents expire in the next 30 days?",
                "What is my passport number and validity?",
                "List all vehicle & health insurance policies",
                "Summarize all active identity cards in my vault",
                "Show documents that need renewal soon"
            };
        }
        @foreach (var s in suggestions)
        {
            <button type="button" class="btn-suggestion-pill" onclick="useSuggestion('@s')">
                <span>@s</span>
                <i class="bi bi-arrow-up-right ms-1"></i>
            </button>
        }
    </div>

    <!-- Chat Card -->
    <div class="ai-chat-window shadow-glow">
        <div class="chat-messages-container" id="chatMessages">
            <!-- Welcome AI message -->
            <div class="chat-bubble-row ai">
                <div class="chat-bubble-avatar ai">
                    <i class="bi bi-robot"></i>
                </div>
                <div class="chat-bubble-content ai">
                    <div class="bubble-meta mb-1">
                        <span class="author-name">DocVault Copilot</span>
                        <span class="timestamp">Just now</span>
                    </div>
                    <div class="bubble-text">
                        👋 Hello! I am your <strong>personal document assistant</strong> powered by Google Gemini and local OCR.<br><br>
                        I have real-time access to the extracted contents, numbers, and expiration dates of all documents currently in your vault. Ask me anything like:
                        <ul class="mb-0 mt-2 ps-3">
                            <li><em>"When does my car or vehicle insurance expire?"</em></li>
                            <li><em>"What is my passport or driving license number?"</em></li>
                            <li><em>"Do I have any documents that are already expired?"</em></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chat Input Footer -->
        <div class="chat-input-wrapper">
            <form class="chat-input-form" id="chatForm">
                <textarea
                    id="chatInput"
                    class="form-control chat-input-field"
                    placeholder="Ask a question about your documents... (e.g. 'What is my Aadhaar or PAN number?')"
                    rows="1"
                    required
                    maxlength="1000"></textarea>
                <button type="submit" class="btn-chat-send" id="chatSubmitBtn" title="Send message">
                    <i class="bi bi-arrow-up-circle-fill"></i>
                </button>
            </form>
            <div class="chat-input-hints d-flex justify-content-between align-items-center px-3 pt-2">
                <span class="text-secondary" style="font-size: 11px;">
                    <i class="bi bi-shield-check text-success me-1"></i>All document text queries run exclusively inside your private session.
                </span>
                <span class="text-secondary d-none d-md-inline" style="font-size: 11px;">
                    Press <kbd class="kbd-subtle">Enter ↵</kbd> to send, <kbd class="kbd-subtle">Shift + Enter</kbd> for newline
                </span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function useSuggestion(text) {
    const input = document.getElementById('chatInput');
    if (input) {
        input.value = text;
        input.focus();
        document.getElementById('chatForm').requestSubmit();
    }
}

// Auto-expand textarea on typing
const chatInput = document.getElementById('chatInput');
if (chatInput) {
    chatInput.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            document.getElementById('chatForm').requestSubmit();
        }
    });
}
</script>
}
