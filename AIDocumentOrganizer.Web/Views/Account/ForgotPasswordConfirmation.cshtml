@{
    ViewData["Title"] = "Confirmation Sent";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="auth-page">
    <div class="auth-card text-center">
        <div class="auth-logo" style="background:linear-gradient(135deg,#2ec4b6,#4361ee);"><i class="bi bi-envelope-check-fill"></i></div>
        <h1 class="auth-title">Check Your Email</h1>
        <p class="auth-sub">If an account with that email exists, a reset link has been sent. Check your inbox (and spam folder).</p>
        <a asp-action="Login" class="btn btn-primary w-100 py-2 mt-3"><i class="bi bi-box-arrow-in-right me-2"></i>Back to Sign In</a>
    </div>
</div>
