@{
    ViewData["Title"] = "Instructions Sent — DocVault";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-wrapper">
    <!-- Ambient ambient glow spheres -->
    <div class="auth-ambient-glow auth-glow-1"></div>
    <div class="auth-ambient-glow auth-glow-2"></div>

    <div class="auth-card-modern text-center">
        <div class="auth-logo-modern mb-3 mx-auto" style="background:linear-gradient(135deg,#10b981,#06b6d4);">
            <i class="bi bi-envelope-check-fill"></i>
        </div>
        <h2 class="auth-title-modern">Check Your <span class="gradient-text">Email</span></h2>
        <p class="auth-subtitle-modern mb-4">If an account with that email exists in DocVault, a reset link has been dispatched. Please check your inbox and spam folders.</p>

        <a asp-action="Login" class="btn btn-gradient-primary w-100 py-2-5 shadow-glow">
            <i class="bi bi-box-arrow-in-right me-2"></i>Back to Sign In
        </a>
    </div>
</div>
