@model AIDocumentOrganizer.Web.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-logo"><i class="bi bi-person-plus-fill"></i></div>
        <h1 class="auth-title">Create Account</h1>
        <p class="auth-sub">Start organizing your documents securely</p>

        <form asp-action="Register" method="post" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="alert alert-danger mb-3 d-none" id="errorSummary"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label"></label>
                <div class="input-group-icon">
                    <i class="bi bi-person"></i>
                    <input asp-for="FullName" class="form-control ps-4" placeholder="Your full name" autocomplete="name" />
                </div>
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" placeholder="Min 8 chars, 1 upper, 1 digit, 1 symbol" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat password" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2">
                <i class="bi bi-rocket-takeoff me-2"></i>Create Account
            </button>
        </form>

        <p class="text-center mt-4 mb-0" style="font-size:14px; color:var(--text-secondary);">
            Already have an account? <a asp-action="Login">Sign in</a>
        </p>
    </div>
</div>

<style>
.input-group-icon { position: relative; }
.input-group-icon i { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 15px; z-index: 1; }
</style>
