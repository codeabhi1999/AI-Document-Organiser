@{
    ViewData["Title"] = "Access Denied";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="auth-page">
    <div class="auth-card text-center">
        <div class="auth-logo" style="background:linear-gradient(135deg,#e63946,#7209b7);"><i class="bi bi-shield-x-fill"></i></div>
        <h1 class="auth-title">Access Denied</h1>
        <p class="auth-sub">You don't have permission to view this page.</p>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary w-100 py-2 mt-3"><i class="bi bi-grid me-2"></i>Go to Dashboard</a>
    </div>
</div>
