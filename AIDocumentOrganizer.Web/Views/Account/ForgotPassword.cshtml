@model AIDocumentOrganizer.Web.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password — DocVault";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-wrapper">
    <!-- Ambient ambient glow spheres -->
    <div class="auth-ambient-glow auth-glow-1"></div>
    <div class="auth-ambient-glow auth-glow-2"></div>

    <div class="auth-card-modern">
        <div class="text-center mb-4">
            <div class="auth-logo-modern mb-3 mx-auto" style="background: linear-gradient(135deg, var(--warning), var(--accent));">
                <i class="bi bi-key-fill"></i>
            </div>
            <h2 class="auth-title-modern">Reset <span class="gradient-text">Password</span></h2>
            <p class="auth-subtitle-modern">Enter your registered email and we'll send password recovery instructions</p>
        </div>

        @if (TempData["Info"] is string info)
        {
            <div class="alert alert-info py-2 px-3 small border-0 mb-4" style="background:rgba(56,189,248,0.15); border-radius:var(--radius-md); color:#7dd3fc;">
                <i class="bi bi-info-circle-fill me-2"></i>@info
            </div>
        }

        <form asp-action="ForgotPassword" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div class="mb-4">
                <label asp-for="Email" class="form-label-modern">Account Email Address</label>
                <div class="input-icon-group">
                    <i class="bi bi-envelope-fill input-icon"></i>
                    <input asp-for="Email" class="form-control-modern" placeholder="name@example.com" autocomplete="email" required />
                </div>
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
            </div>

            <button type="submit" class="btn btn-gradient-primary w-100 py-2-5 shadow-glow mb-3">
                <i class="bi bi-send-fill me-2"></i>Send Recovery Instructions
            </button>
        </form>

        <p class="text-center mt-3 mb-0 text-secondary small">
            Remembered your password? <a asp-action="Login" class="text-primary fw-semibold text-decoration-none">← Back to Sign In</a>
        </p>
    </div>
</div>
