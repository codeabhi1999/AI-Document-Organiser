@model AIDocumentOrganizer.Web.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In — DocVault";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-wrapper">
    <!-- Ambient ambient glow spheres -->
    <div class="auth-ambient-glow auth-glow-1"></div>
    <div class="auth-ambient-glow auth-glow-2"></div>

    <div class="auth-card-modern">
        <!-- Logo & Header -->
        <div class="text-center mb-4">
            <div class="auth-logo-modern mb-3 mx-auto">
                <i class="bi bi-cpu-fill"></i>
            </div>
            <h2 class="auth-title-modern">Welcome to <span class="gradient-text">DocVault</span></h2>
            <p class="auth-subtitle-modern">Intelligent, encrypted personal document management</p>
        </div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div asp-validation-summary="All" class="alert alert-danger-modern mb-4"></div>
        }

        <form asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post" id="loginForm" novalidate>
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Email" class="form-label-modern">Email Address</label>
                <div class="input-icon-group">
                    <i class="bi bi-envelope-fill input-icon"></i>
                    <input asp-for="Email" class="form-control-modern" id="emailInput" placeholder="name@example.com" autocomplete="email" required />
                </div>
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label asp-for="Password" class="form-label-modern mb-0">Password</label>
                    <a asp-action="ForgotPassword" class="auth-link-subtle">Forgot password?</a>
                </div>
                <div class="input-icon-group">
                    <i class="bi bi-shield-lock-fill input-icon"></i>
                    <input asp-for="Password" class="form-control-modern" id="passwordInput" type="password" placeholder="••••••••••••" autocomplete="current-password" required />
                    <button type="button" class="btn-toggle-pwd" id="togglePasswordBtn" title="Show/Hide Password">
                        <i class="bi bi-eye-slash-fill" id="pwdEyeIcon"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="d-flex align-items-center justify-content-between mb-4">
                <div class="form-check custom-checkbox">
                    <input asp-for="RememberMe" class="form-check-input" id="rememberMe" />
                    <label asp-for="RememberMe" class="form-check-label" for="rememberMe">Remember this browser</label>
                </div>
            </div>

            <button type="submit" class="btn btn-gradient-primary w-100 py-2-5 shadow-glow mb-4">
                <i class="bi bi-box-arrow-in-right me-2"></i>Sign In to Vault
            </button>
        </form>

        <!-- 1-Click Quick Demo Access -->
        <div class="quick-demo-section pt-3 border-top border-secondary-subtle">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="quick-demo-title"><i class="bi bi-lightning-charge-fill text-warning me-1"></i>1-Click Quick Demo</span>
                <span class="badge bg-secondary-subtle text-secondary" style="font-size: 10px;">PRE-POPULATE</span>
            </div>
            <div class="row g-2">
                <div class="col-6">
                    <button type="button" class="btn btn-demo-pill w-100" onclick="fillCredentials('admin@docorganizer.com', 'Admin@123!')">
                        <i class="bi bi-shield-shaded text-primary me-1"></i> Admin Demo
                    </button>
                </div>
                <div class="col-6">
                    <button type="button" class="btn btn-demo-pill w-100" onclick="fillCredentials('user@docorganizer.com', 'User@123!')">
                        <i class="bi bi-person-fill text-info me-1"></i> User Demo
                    </button>
                </div>
            </div>
        </div>

        <p class="text-center mt-4 mb-0 text-secondary small">
            New to DocVault? <a asp-action="Register" class="text-primary fw-semibold text-decoration-none">Create a free vault</a>
        </p>
    </div>
</div>

@section Scripts {
    <script>
        function fillCredentials(email, pwd) {
            const emailField = document.getElementById('emailInput');
            const pwdField = document.getElementById('passwordInput');
            if (emailField && pwdField) {
                emailField.value = email;
                pwdField.value = pwd;
                emailField.classList.add('pulse-highlight');
                pwdField.classList.add('pulse-highlight');
                setTimeout(() => {
                    emailField.classList.remove('pulse-highlight');
                    pwdField.classList.remove('pulse-highlight');
                }, 1000);
            }
        }

        const toggleBtn = document.getElementById('togglePasswordBtn');
        if (toggleBtn) {
            toggleBtn.addEventListener('click', function() {
                const pwdInput = document.getElementById('passwordInput');
                const icon = document.getElementById('pwdEyeIcon');
                if (pwdInput.type === 'password') {
                    pwdInput.type = 'text';
                    icon.className = 'bi bi-eye-fill';
                } else {
                    pwdInput.type = 'password';
                    icon.className = 'bi bi-eye-slash-fill';
                }
            });
        }
    </script>
}
