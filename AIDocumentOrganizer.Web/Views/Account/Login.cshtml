@model AIDocumentOrganizer.Web.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-logo"><i class="bi bi-shield-lock-fill"></i></div>
        <h1 class="auth-title">Welcome Back</h1>
        <p class="auth-sub">Sign in to your Document Organizer</p>

        <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>

        <form asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label asp-for="Password" class="form-label mb-0">Password</label>
                    <a asp-action="ForgotPassword" style="font-size:12px;">Forgot password?</a>
                </div>
                <input asp-for="Password" class="form-control" placeholder="Your password" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label" style="font-size:13px; color:var(--text-secondary);">Keep me signed in for 7 days</label>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2">
                <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
            </button>
        </form>

        <div class="mt-4 pt-3" style="border-top:1px solid var(--border);">
            <p class="text-center mb-2" style="font-size:12px; color:var(--text-muted);">Development Test Credentials</p>
            <div class="d-flex gap-2 flex-column">
                <div style="background:var(--bg-input); border:1px solid var(--border); border-radius:8px; padding:8px 12px; font-size:12px; color:var(--text-secondary);">
                    <strong style="color:var(--text-primary);">Admin:</strong> admin@docorganizer.com / Admin@123!
                </div>
                <div style="background:var(--bg-input); border:1px solid var(--border); border-radius:8px; padding:8px 12px; font-size:12px; color:var(--text-secondary);">
                    <strong style="color:var(--text-primary);">User:</strong> user@docorganizer.com / User@123!
                </div>
            </div>
        </div>

        <p class="text-center mt-4 mb-0" style="font-size:14px; color:var(--text-secondary);">
            Don't have an account? <a asp-action="Register">Create one</a>
        </p>
    </div>
</div>
