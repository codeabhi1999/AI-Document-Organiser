{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=AIDocumentOrganizer;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "AppSettings": {
    "MaxFileSizeMB": 15,
    "AllowedExtensions": [ ".pdf", ".jpg", ".jpeg", ".png" ],
    "SecureUploadPath": "App_Data/SecureUploads",
    "SupportEmail": "support@docorganizer.com"
  },
  "AiService": {
    "Provider": "Gemini",
    "GeminiApiKey": "",
    "GeminiModel": "gemini-1.5-flash",
    "GeminiBaseUrl": "https://generativelanguage.googleapis.com/v1beta/models",
    "MaxRetries": 2,
    "TimeoutSeconds": 30
  },
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "EnableSsl": true,
    "SenderEmail": "",
    "SenderName": "AI Document Organizer",
    "SenderPassword": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
